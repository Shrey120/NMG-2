{
  "name": "outlier-autowerke",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix server run dev",
    "dev:web": "npm --prefix client run dev",
    "setup": "npm install && npm --prefix server install && npm --prefix client install",
    "db:setup": "npm --prefix server run db:setup",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
