# Copy this file to .env and fill in your own MySQL details.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=outlier_autowerke

# Used to sign login tokens. Any long random string.
JWT_SECRET=change-this-to-a-long-random-string

# The admin account created by "npm run db:setup".
ADMIN_NAME=Workshop Admin
ADMIN_EMAIL=admin@outlierautowerke.com
ADMIN_PASSWORD=admin1234

PORT=4100

# --- Email --------------------------------------------------------------
# Full step by step instructions: docs/email-setup.md
# Check your settings with:  npm run mail:test
#
# Leave MAIL_HOST blank and nothing is sent; every email is still recorded in
# the emailLog table and printed in the terminal.
#
# Local test inbox (Mailpit):  MAIL_HOST=127.0.0.1   MAIL_PORT=1025  user/password empty
# Gmail:                       MAIL_HOST=smtp.gmail.com  MAIL_PORT=587
#                              MAIL_PASSWORD must be a Gmail App Password
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# Who receives owner notifications: new bookings, enquiries, new staff.
MAIL_TO=

# The address of the website, used to build the Accept and Decline links in
# the owner's booking email. Change it to the real address once the site is live.
PUBLIC_URL=http://localhost:5173
