# Copy this file to .env and fill in your own MySQL details.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=outlier_autowerke

# Used to sign login tokens. Any long random string.
JWT_SECRET=change-this-to-a-long-random-string

# The admin account created by "npm run db:setup".
ADMIN_NAME=Workshop Admin
ADMIN_EMAIL=admin@outlierautowerke.com
ADMIN_PASSWORD=admin1234

PORT=4100

# Where enquiries are emailed, as well as appearing on the dashboard.
# Leave MAIL_HOST blank and enquiries are logged to the terminal instead of
# sent, which is what happens until the client gives us a mail account.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
