# Copy this file to .env and fill in your own MySQL details.
# 127.0.0.1 rather than localhost: on some Windows machines localhost resolves
# to an IPv6 address that MySQL is not listening on.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=outlier_autowerke

# Used to sign login tokens. Any long random string.
JWT_SECRET=change-this-to-a-long-random-string

# The admin account created by "npm run db:setup".
ADMIN_NAME=Workshop Admin
ADMIN_EMAIL=admin@outlierautowerke.com
ADMIN_PASSWORD=admin1234

PORT=4100

# --- Email --------------------------------------------------------------
# The mailbox the website SENDS from. For Gmail, MAIL_PASSWORD is a 16 letter
# App Password, not your Gmail password. Step by step: docs/email-setup.md
#
# Where emails are delivered is NOT set here. Booking and contact emails go to
# the address in Admin panel -> Business details.
#
# Check it with:  npm run mail:test
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# The address of the website, used for the Accept and Decline links in the
# booking email. Change it to the real address once the site is live.
PUBLIC_URL=http://localhost:5173
